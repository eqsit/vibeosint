# Copy to .env, fill your own secrets; never commit .env.
# PANEL_PASSWORD must contain at least 16 characters. Empty refuses startup.
PANEL_PASSWORD=
PANEL_PORT=3000
# Standalone launcher resolves data/workspace/web paths inside panel/ by default.
# Use a separate Hermes installation/profile for this project.
HERMES_BIN=hermes
HERMES_HOME=.hermes-home
HERMES_RUNTIME_DIR=.hermes-home/tools
HERMES_MODEL=opencode-go/deepseek-v4.1-flash
HERMES_PROVIDER=omniroute
HERMES_REASONING=xhigh

# Configure provider keys in this project's Hermes home, NOT in Git.
SERPER_API_KEY=
OPENCODE_GO_API_KEY=
# Optional vision: your own OpenAI-compatible gateway and accepted model alias.
OSINT_VISION_BASE=http://127.0.0.1:8000/v1
OSINT_VISION_MODEL=your-vision-model
OSINT_VISION_KEY=
# Optional SearXNG. No SearXNG service is bundled.
OSINT_SEARXNG_URL=http://127.0.0.1:8888/search

# Optional Telegram integrations: provide YOUR app and authorized account pool.
# No sessions, accounts, bot routes or API credentials ship with this repository.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PRIMARY_ACCOUNT_ID=
LAZYAPI_BOT_USERNAME=
OSINT_PRIMARY_BOT_USERNAME=
OSINT_FALLBACK_BOT_USERNAME=
